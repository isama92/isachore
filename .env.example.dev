# The DEVELOPMENT template: `cp .env.example.dev .env` and you are ready to run
# `docker compose up --build`. These are documented placeholder credentials, and
# the whole dev stack is published on loopback only - never reuse any of it
# anywhere real, and never commit .env itself.
#
# For a real deployment copy .env.example instead: it is the production
# reference, and the backend refuses to boot outside a dev environment while its
# placeholders are still in place. None of those checks run here.

# --- Postgres ---
POSTGRES_USER=isachore
POSTGRES_PASSWORD=isachore_dev_password
POSTGRES_DB=isachore

# --- Backend ---
# A dev-like marker (dev / development / local / test / testing) does two things:
# it lets the destructive `python -m app.cli seed` run, and it skips the startup
# config check that would reject everything below.
ENVIRONMENT=dev

# Dev is served over plain HTTP, so the Secure flag has to come off or the login
# cookie is never sent back. Never false in a real deployment.
COOKIES_SECURE=false

# Optional in dev: leave it as-is and encryption simply stays unavailable, which
# means 2FA setup and 2FA logins return 503. To work on 2FA locally, generate a
# real key with `docker compose exec backend python -m app.cli generate-key`.
APP_KEY=changeme-generate-a-fernet-key

# Inside docker compose the host is "db"; for tooling running directly on your
# machine, override the host to localhost (port 5432 is published in dev).
DATABASE_URL=postgresql+asyncpg://isachore:isachore_dev_password@db:5432/isachore

# Redis backs login rate limiting. The host is "redis" on the compose network;
# nothing else sets this for you, and a wrong value is quiet rather than fatal
# (the throttle fails open on a Redis error), so leave it as-is or you will be
# developing with rate limiting silently switched off. Running tooling directly
# on your machine instead? Redis is not published to the host at all.
# The throttle can be tuned with LOGIN_MAX_ATTEMPTS, LOGIN_IP_MAX_ATTEMPTS,
# LOGIN_ATTEMPT_WINDOW (seconds). Leave TRUST_FORWARDED_FOR off: it belongs
# behind a trusted reverse proxy, and here it would let any client spoof its IP
# past the per-IP throttle.
REDIS_URL=redis://redis:6379/0

# --- Uploaded files (avatars) ---
# Defaults are fine in dev; see .env.example for what each one bounds.
# STORAGE_DIR=storage
# AVATAR_MAX_BYTES=5242880
# AVATAR_PX=512

# --- Email (SMTP) ---
# Pointed at the mailpit service from compose.yml, which speaks plain SMTP with
# no auth: hence port 1025 and STARTTLS off. Captured mail (confirmation links,
# the admin test email) shows up at http://localhost:8025 and never leaves your
# machine. Without these the app still runs, but "require user confirmation" and
# the test-email button are unavailable.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=isachore <no-reply@isachore.localhost>

# Public SPA origin used to build emailed links; the Vite dev server in dev.
APP_BASE_URL=http://localhost:5173
