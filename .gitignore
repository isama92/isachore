# env
.env
.env.*
!.env.example
# Needs its own negation: the !.env.example line above does not cover it, so
# without this the dev template is silently never committed.
!.env.example.dev

# python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# node
node_modules/
dist/
coverage/
*.local
npm-debug.log*

# editors / os
.idea/
.vscode/
.DS_Store

# uploaded files (avatars) — keep the dir, ignore its contents
backend/storage/*
!backend/storage/.gitkeep

# prod compose runtime data (TLS certs, postgres data). Unanchored so it also
# covers docker/volumes/, which is where a mode file run from docker/ puts them.
volumes/

# rendered API reference. openapi.yaml IS committed (it is the published contract);
# this is a ~900 kB single-file render of it that anyone can rebuild in one command.
docs/api/openapi.html

# browser-session artefacts (page snapshots, console logs) written by the
# Playwright MCP server during by-hand UI checks
.playwright-mcp/
