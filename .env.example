# Copy to .env and adjust. These are dev-only placeholder credentials -
# never reuse them anywhere real, and never commit .env itself.

# --- Postgres ---
POSTGRES_USER=isachore
POSTGRES_PASSWORD=isachore_dev_password
POSTGRES_DB=isachore

# --- Backend ---
# "prod" turns on the Secure flag for auth cookies
ENVIRONMENT=dev

# Inside docker compose the host is "db". For tooling running directly on
# your machine, override the host to localhost (port 5432 is published in dev).
DATABASE_URL=postgresql+asyncpg://isachore:isachore_dev_password@db:5432/isachore
