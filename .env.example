# Copy to .env and adjust. These are dev-only placeholder credentials -
# never reuse them anywhere real, and never commit .env itself.

# --- Postgres ---
POSTGRES_USER=isachore
POSTGRES_PASSWORD=isachore_dev_password
POSTGRES_DB=isachore

# --- Backend ---
# Deployment marker (dev|prod). Informational only; it does not control cookie
# security anymore (see COOKIES_SECURE).
ENVIRONMENT=dev

# Auth cookies get the Secure flag (HTTPS only) by default, so forgetting to
# configure this fails closed. This false is a DEV-ONLY opt-out because dev is
# served over plain HTTP. Never set it false in production (which must
# terminate TLS); leave it unset or true there.
COOKIES_SECURE=false

# Inside docker compose the host is "db". For tooling running directly on
# your machine, override the host to localhost (port 5432 is published in dev).
DATABASE_URL=postgresql+asyncpg://isachore:isachore_dev_password@db:5432/isachore

# Redis backs login rate limiting. In docker compose the URL is set for you
# (host "redis"); this value is only for tooling running directly on your machine.
# The login throttle can be tuned with LOGIN_MAX_ATTEMPTS, LOGIN_IP_MAX_ATTEMPTS,
# LOGIN_ATTEMPT_WINDOW (seconds). Set TRUST_FORWARDED_FOR=true only behind a
# trusted reverse proxy (e.g. prod nginx).
REDIS_URL=redis://localhost:6379/0

# --- Uploaded files (avatars) ---
# Where uploaded profile pictures are stored, relative to the backend working
# dir (/app in the container). Backed by a bind mount in dev and a named volume
# in prod so files survive restarts. Defaults are fine; override only if needed.
# STORAGE_DIR=storage
# AVATAR_MAX_BYTES=5242880
# AVATAR_PX=512

# --- Email (SMTP) ---
# Used for account-confirmation and test emails. Optional at boot: the app runs
# without them, but "require user confirmation" (Server settings) and the
# test-email button need a host + from address. In dev, compose.yml already
# points these at the mailpit service (host mailpit:1025, no TLS/auth), so you
# don't need to set them here; view captured mail at http://localhost:8025.
# In prod, set real values in .env (username/password optional if the relay
# doesn't require auth). Use SMTP_STARTTLS for port 587 or SMTP_USE_TLS for 465.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=isachore <no-reply@example.com>
# SMTP_STARTTLS=true
# SMTP_USE_TLS=false
# Public base URL of the SPA, used to build the confirmation link in emails.
# Dev is set by compose (http://localhost:5173); set the real origin in prod.
# APP_BASE_URL=https://isachore.example.com
