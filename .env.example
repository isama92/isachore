# The PRODUCTION reference: copy to .env and replace every placeholder below.
# For local development copy .env.example.dev instead, which is ready to run.
# Never commit .env itself.
#
# The backend refuses to boot outside a dev environment while the placeholders
# are still in place (see app/core/startup.py): a publicly known password in
# DATABASE_URL, or an unusable APP_KEY, stops the deploy instead of failing
# quietly later.

# --- Postgres ---
# REPLACE the password with a strong secret, and keep it identical in
# DATABASE_URL below - they are two independent paths to the same credential
# (compose interpolates this one into the db service, the backend reads that
# one). The boot check inspects DATABASE_URL, since that is the one the backend
# authenticates with, and rejects this placeholder.
POSTGRES_USER=isachore
POSTGRES_PASSWORD=isachore_dev_password
POSTGRES_DB=isachore

# --- Backend ---
# Deployment marker, e.g. dev / test / prod (any value is accepted). It does not
# control cookie security (see COOKIES_SECURE). Two things gate on it: the
# destructive `python -m app.cli seed` only runs on a dev-like value
# (dev / development / local / test / testing), and the startup config check only
# runs when it is NOT one of those. Defaults to prod, and anything unrecognised
# (a typo included) reads as a real deployment, so both gates fail safe.
ENVIRONMENT=prod

# Auth cookies get the Secure flag (HTTPS only). Every prod mode terminates TLS
# before the browser, so leave this true; the backend refuses to boot outside a
# dev environment when it is false. Plain-HTTP local dev needs false, which is
# what .env.example.dev sets.
COOKIES_SECURE=true

# REPLACE with a freshly generated key (use the compose file you deploy with, or
# you will start the dev stack instead):
#   docker compose -f compose.prod.tls.yml run --rm backend python -m app.cli generate-key
# Symmetric key encrypting secrets at rest (currently the 2FA TOTP seed), a
# urlsafe-base64 Fernet key. REQUIRED outside a dev environment: a missing or
# malformed value refuses boot, because otherwise every 2FA-enrolled user is
# silently locked out with a 503 at login. WARNING: rotating this key strands
# everything encrypted under the old key (every enrolled 2FA user) until key
# rotation is added. Use distinct keys per environment; never commit a real one.
APP_KEY=changeme-generate-a-fernet-key

# Inside docker compose the host is "db". For tooling running directly on
# your machine, override the host to localhost (port 5432 is published in dev).
# The password here must match POSTGRES_PASSWORD above; this is the one the
# backend authenticates with, so it is the one the boot check inspects.
DATABASE_URL=postgresql+asyncpg://isachore:isachore_dev_password@db:5432/isachore

# Read by the container entrypoint, not by the app: the backend runs `alembic
# upgrade head` before starting the web server, so an upgrade is just `pull` +
# `up -d`. Only the exact lowercase "false" opts out, so a typo here still
# migrates, which is the safe direction. Set it to false if you run MORE THAN ONE
# instance against this database, in every instance but one - two containers
# starting at the same time race on the alembic_version row and the loser
# crash-loops. Nothing serialises them; this is the only safeguard.
# RUN_MIGRATIONS=true

# Redis backs login rate limiting. The host is "redis" on the compose network,
# and nothing sets this for you, so leave it as-is: the throttle fails open on a
# Redis error, meaning a wrong URL here disables login rate limiting silently.
# The throttle can be tuned with LOGIN_MAX_ATTEMPTS, LOGIN_IP_MAX_ATTEMPTS,
# LOGIN_ATTEMPT_WINDOW (seconds). TRUST_FORWARDED_FOR is forced true by the prod
# stack (it runs behind nginx); set it only behind a trusted reverse proxy.
REDIS_URL=redis://redis:6379/0

# --- Uploaded files (avatars) ---
# Where uploaded profile pictures are stored, relative to the backend working
# dir (/app in the container). Backed by a bind mount in dev and a named volume
# in prod so files survive restarts. Defaults are fine; override only if needed.
# STORAGE_DIR=storage
# AVATAR_MAX_BYTES=5242880
# AVATAR_PX=512

# --- Email (SMTP) ---
# Used for account-confirmation and test emails. Optional at boot: the app runs
# without them, but "require user confirmation" (Server settings) and the
# test-email button need a host + from address. In dev, compose.yml already
# points these at the mailpit service (host mailpit:1025, no TLS/auth), so you
# don't need to set them here; view captured mail at http://localhost:8025.
# In prod, set real values in .env (username/password optional if the relay
# doesn't require auth). Use SMTP_STARTTLS for port 587 or SMTP_USE_TLS for 465.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=isachore <no-reply@example.com>
# SMTP_STARTTLS=true
# SMTP_USE_TLS=false
# Public base URL of the SPA, used to build the confirmation link in emails.
# Dev is set by compose (http://localhost:5173); set the real origin in prod.
# In prod, terminate TLS with a reverse proxy or the nginx TLS mode (see the
# Production section in README.md) and set this to that HTTPS origin.
# APP_BASE_URL=https://isachore.example.com

# --- Single sign-on (OIDC) ---
# Optional: with these unset the app is email + password only and the sign-in
# button never renders. Set all three to let people sign in through an OpenID
# Connect provider (Authentik, Authelia, Keycloak, ...). **boot-checked**: setting
# some but not all three refuses boot, because a half-configured provider would
# otherwise fail silently at the first sign-in, and a non-HTTPS issuer refuses boot
# too, since the client secret would cross the wire in plaintext.
#
# OIDC_ISSUER is the provider's base url, the one whose
# <issuer>/.well-known/openid-configuration resolves. For Authentik that is the
# provider's issuer url, typically
# https://auth.example.com/application/o/<application-slug>/
#
# There is no redirect-uri setting: it is derived as
# <APP_BASE_URL>/api/v1/auth/oidc/callback, which is the value to register with the
# provider. Admin > Server settings displays it so you can copy it.
# OIDC_ISSUER=https://auth.example.com/application/o/isachore/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Name shown on the sign-in button ("Sign in with Authentik"). Cosmetic, so it is
# not part of the configured check; defaults to "SSO".
# OIDC_PROVIDER_NAME=Authentik

# Scopes requested from the provider. "openid" is required, and "email" is what the
# account is matched on, so only widen this.
# OIDC_SCOPES=openid email profile

# Turns password sign-in off: hides the email + password form and makes
# POST /auth/login return 403. **boot-checked**: turning it on without a configured
# provider refuses boot, because it would lock every user out including you. There
# is no in-app break-glass: recovering means setting this back to false and
# restarting the backend, so be sure SSO works before turning it on.
#
# Note it switches off password sign-IN, not every route that opens a session: an
# account confirmation link still sets a password and logs that person in, which is
# how an admin-created account gets set up. Leave REQUIRE confirmation off (Admin >
# Server settings) if you want the provider to be the only path in practice.
# OIDC_ONLY=false
